---
layout: layouts/base.njk
title: Хэрэгцээт мэдээлэл
description: Санхүүчдийн календарь, гарын авлага, загвар маягт болон нягтлан бодогчдод зориулсан “Ня-Бо” аппын мэдээлэл.
permalink: /medeelel/
---
{%- from "partials/macros.njk" import pageHero %}
{{ pageHero("Мэдээлэл", "Хэрэгцээт мэдээлэл", "Нягтлан бодогч, санхүүчдэд хэрэгтэй гарын авлага, загвар, тооцооны хүснэгт, календарийг эндээс татаж авах боломжтой.") }}

<section class="section">
  <div class="container">
    {%- if collections.materials.length %}
    <ul class="materials">
      {%- for m in collections.materials %}
      {%- set mt = materialTypes | findBy("key", m.data.type) %}
      <li class="material{% if m.data.cover %} has-cover{% endif %}">
        {%- if m.data.cover %}
        <img class="material-cover" src="{{ m.data.cover }}" alt="" loading="lazy">
        {%- else %}
        <div class="material-icon" aria-hidden="true">{{ (m.data.file | fileExt) or "URL" }}</div>
        {%- endif %}
        <div class="material-body">
          {%- if mt %}<p class="card-meta"><span class="chip chip-sm">{{ mt.label }}</span></p>{% endif %}
          <h3>{{ m.data.title }}</h3>
          {%- if m.data.description %}<p class="card-text">{{ m.data.description }}</p>{% endif %}
        </div>
        <div class="material-actions">
          {%- if m.data.file %}<a class="btn btn-primary btn-sm" href="{{ m.data.file }}" download>Татах{% if m.data.file | fileExt %} ({{ m.data.file | fileExt }}){% endif %}</a>{% endif %}
          {%- if m.data.link %}<a class="btn btn-outline btn-sm" href="{{ m.data.link }}" rel="noopener" target="_blank">Нээх</a>{% endif %}
        </div>
      </li>
      {%- endfor %}
    </ul>
    {%- else %}
    <div class="empty-state empty-state-box">
      <p class="empty-title">Татаж авах материал удахгүй нэмэгдэнэ.</p>
      <p>Гарын авлага, загвар маягт, тооцооны хүснэгтүүдийг энд байршуулах болно.</p>
    </div>
    {%- endif %}
  </div>
</section>

<section class="section section-tint">
  <div class="container two-col">
    <div class="calendar-feature">
      <p class="eyebrow">2019 оноос жил бүр</p>
      <h2>Санхүүчдийн календарь</h2>
      <p>{{ company.calendar_intro }}</p>
      <ul class="check-list check-list-2col">
        {%- for c in company.calendar_items %}<li>{{ c }}</li>{% endfor %}
      </ul>
      {%- if company.calendar_images and company.calendar_images.length %}
      <div class="cal-photos">
        {%- for im in company.calendar_images %}
        <figure class="cal-photo">
          <img src="{{ im.image }}" alt="{{ im.caption or 'Санхүүчдийн календарь' }}" loading="lazy">
          {%- if im.caption %}<figcaption>{{ im.caption }}</figcaption>{% endif %}
        </figure>
        {%- endfor %}
      </div>
      {%- endif %}
    </div>
    <div class="app-feature">
      <p class="eyebrow">Монголын анхны НББ-ийн апп</p>
      <h2>“Ня-Бо” апп</h2>
      {%- if company.nyabo_text %}<p>{{ company.nyabo_text }}</p>{% endif %}
      {%- if company.nyabo_features and company.nyabo_features.length %}
      <ul class="check-list">
        {%- for f in company.nyabo_features %}<li>{{ f }}</li>{% endfor %}
      </ul>
      {%- endif %}
      {%- if company.nyabo_images and company.nyabo_images.length %}
      <div class="app-shots">
        {%- for im in company.nyabo_images %}
        <figure class="app-shot">
          <img src="{{ im.image }}" alt="“Ня-Бо” апп: {{ im.caption }}" loading="lazy">
          {%- if im.caption %}<figcaption>{{ im.caption }}</figcaption>{% endif %}
        </figure>
        {%- endfor %}
      </div>
      {%- endif %}
    </div>
  </div>
</section>

{% include "partials/contact-band.njk" %}
