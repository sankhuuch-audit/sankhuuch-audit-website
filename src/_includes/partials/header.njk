<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="{{ site.name }}, нүүр хуудас">
      <img class="brand-logo" src="/assets/img/logo.svg" width="66" height="41" alt="">
      <span class="brand-text">
        <span class="brand-name">{{ site.name }}</span>
        <span class="brand-sub">2008 оноос хойш</span>
      </span>
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Цэс нээх">
      <span class="nav-toggle-bars" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="nav-toggle-label">Цэс</span>
    </button>
    <nav class="site-nav" id="site-nav" aria-label="Үндсэн цэс">
      <ul>
        {%- for item in navigation %}
        {%- set active = (page.url == item.url) or (item.url != "/" and (page.url | string).startsWith(item.url)) %}
        {%- if item.url == '/zuvlugu/' %}
        <li class="has-sub">
          <a href="{{ item.url }}"{% if active %} aria-current="page"{% endif %}>{{ item.label }}<svg class="nav-caret" width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M2 3.5 5 6.5 8 3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
          <ul class="sub-nav" aria-label="{{ item.label }}: ангилал">
            {%- for c in categories %}
            {%- set curl = "/zuvlugu/angilal/" + c.key + "/" %}
            <li><a href="{{ curl }}"{% if page.url == curl %} aria-current="page"{% endif %}>{{ c.label }}</a></li>
            {%- endfor %}
          </ul>
        </li>
        {%- else %}
        <li{% if item.url == '/' %} class="nav-home"{% endif %}><a href="{{ item.url }}" class="{% if item.url == '/unii-sanal/' %}nav-cta{% endif %}"{% if active %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {%- endif %}
        {%- endfor %}
      </ul>
    </nav>
  </div>
</header>
