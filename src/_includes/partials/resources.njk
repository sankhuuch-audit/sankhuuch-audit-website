<section class="section section-tint" id="tatah-material">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">Хэрэгцээт мэдээлэл</p>
      <h2>Татаж авах материал</h2>
      <p class="section-intro">Нягтлан бодогч, санхүүчдэд хэрэгтэй гарын авлага, загвар, тооцооны хүснэгт, календарийг эндээс татаж авах боломжтой.</p>
    </div>
    {% include "partials/materials-list.njk" %}
  </div>
</section>

<section class="section" id="kalendar">
  <div class="container two-col">
    <div class="calendar-feature">
      <p class="eyebrow">2019 оноос жил бүр</p>
      <h2>Санхүүчдийн календарь</h2>
      <p>{{ company.calendar_intro }}</p>
      <ul class="check-list check-list-2col">
        {%- for c in company.calendar_items %}<li>{{ c }}</li>{% endfor %}
      </ul>
      {%- if company.calendar_images and company.calendar_images.length %}
      <div class="cal-photos">
        {%- for im in company.calendar_images %}
        <figure class="cal-photo">
          <img src="{{ im.image }}" alt="{{ im.caption or 'Санхүүчдийн календарь' }}" loading="lazy">
          {%- if im.caption %}<figcaption>{{ im.caption }}</figcaption>{% endif %}
        </figure>
        {%- endfor %}
      </div>
      {%- endif %}
    </div>
    <div class="app-feature">
      <p class="eyebrow">Монголын анхны НББ-ийн апп</p>
      <h2>“Ня-Бо” апп</h2>
      {%- if company.nyabo_text %}<p>{{ company.nyabo_text }}</p>{% endif %}
      {%- if company.nyabo_features and company.nyabo_features.length %}
      <ul class="check-list">
        {%- for f in company.nyabo_features %}<li>{{ f }}</li>{% endfor %}
      </ul>
      {%- endif %}
      {%- if company.nyabo_images and company.nyabo_images.length %}
      <div class="app-shots">
        {%- for im in company.nyabo_images %}
        <figure class="app-shot">
          <img src="{{ im.image }}" alt="“Ня-Бо” апп: {{ im.caption }}" loading="lazy">
          {%- if im.caption %}<figcaption>{{ im.caption }}</figcaption>{% endif %}
        </figure>
        {%- endfor %}
      </div>
      {%- endif %}
    </div>
  </div>
</section>

