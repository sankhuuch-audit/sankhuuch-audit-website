{%- set isEn = (lang == "en") %}
{%- set S = en.site if isEn else site %}
<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <img class="footer-logo" src="/assets/img/logo-light.svg" width="104" height="64" alt="{{ S.name }} {{ 'logo' if isEn else 'лого' }}" loading="lazy">
      <p class="footer-name">{{ S.name }}</p>
      <p class="footer-tagline">{{ S.tagline }}</p>
      <a class="footer-badge" href="{{ site.monicpa_url }}" rel="noopener" target="_blank">{{ "MonICPA member" if isEn else "ММНБИ-ийн гишүүн" }}</a>
    </div>
    <nav class="footer-col" aria-label="{{ 'Pages' if isEn else 'Хуудсууд' }}">
      <h2 class="footer-h">{{ "Pages" if isEn else "Хуудсууд" }}</h2>
      <ul>
        {%- for item in (en.navigation if isEn else navigation) %}<li><a href="{{ item.url }}">{{ item.label }}</a></li>{% endfor %}
        {%- if not isEn %}<li><a href="/tootsooluur/">Цалингийн тооцоолуур</a></li>{% endif %}
      </ul>
    </nav>
    {%- if isEn %}
    <nav class="footer-col" aria-label="Resources in Mongolian">
      <h2 class="footer-h">In Mongolian</h2>
      <ul>
        {%- for r in en.mn_resources %}<li><a href="{{ r.url }}" hreflang="mn">{{ r.label }}</a></li>{% endfor %}
      </ul>
    </nav>
    {%- else %}
    <nav class="footer-col" aria-label="Зөвлөгөөний ангилал">
      <h2 class="footer-h">Зөвлөгөө</h2>
      <ul>
        {%- for c in categories %}<li><a href="/zuvlugu/angilal/{{ c.key }}/">{{ c.label }}</a></li>{% endfor %}
        <li><a href="/zuvlugu/failuud/">Хэрэгцээт файл</a></li>
      </ul>
    </nav>
    {%- endif %}
    <div class="footer-col">
      <h2 class="footer-h">{{ "Contact" if isEn else "Холбоо барих" }}</h2>
      <address>
        <p>{{ S.address }}</p>
        <p>{% for p in site.phones %}<a href="{{ p | telHref }}">{{ p }}</a>{% if not loop.last %}<br>{% endif %}{% endfor %}</p>
        <p><a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
      </address>
      {%- if site.youtube_channel or site.facebook_url %}
      <p class="footer-social">
        {%- if site.youtube_channel %}<a href="{{ site.youtube_channel }}" rel="noopener" target="_blank">{{ "YouTube channel" if isEn else "YouTube суваг" }}</a>{% endif %}
        {%- if site.facebook_url %}<a href="{{ site.facebook_url }}" rel="noopener" target="_blank">Facebook</a>{% endif %}
      </p>
      {%- endif %}
    </div>
  </div>
  <div class="container footer-bottom">
    <p>© {{ build.year }} {{ S.name }}. {{ "All rights reserved." if isEn else "Бүх эрх хуулиар хамгаалагдсан." }}</p>
    {%- if site.ga_id | gaId %}
    <p class="footer-note">{{ "We use Google Analytics (cookies) to measure site traffic." if isEn else "Хандалтын статистикт Google Analytics (cookie) ашигладаг." }}</p>
    {%- endif %}
    <p class="tribar-line" aria-hidden="true"><span class="tribar"><i></i><i></i><i></i></span></p>
  </div>
</footer>
